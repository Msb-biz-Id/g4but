APP_NAME=e-KASUARI
# DEV: local | PROD: production
APP_ENV=local
APP_KEY=
# DEV: true | PROD: false  ← WAJIB false di production (mencegah expose stacktrace)
APP_DEBUG=true
# DEV: http://localhost:4040 | PROD: https://domain-anda.go.id
APP_URL=http://localhost:4040

# DEV: id | PROD: id
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta
DB_TIMEZONE=+07:00

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Autentikasi Dua Faktor (MFA)
MFA_ENABLED=false

BCRYPT_ROUNDS=12

# DEV: stack/single+debug | PROD: daily+warning
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=30

# DEV: sqlite | PROD: pgsql (PostgreSQL 16)
DB_CONNECTION=sqlite
# Untuk production — uncomment dan isi:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=ekasuari_prod
# DB_USERNAME=ekasuari_user
# DB_PASSWORD=
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
# DEV: false | PROD: true  ← enkripsi data sesi di server
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# DEV: (kosong) | PROD: true  ← hanya kirim cookie lewat HTTPS
SESSION_SECURE_COOKIE=
# Selalu true
SESSION_HTTP_ONLY=true
# Supported: "lax", "strict", "none"
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# DEV: log (tulis ke file) | PROD: smtp (kirim email nyata)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# PROD: ganti ke email resmi organisasi
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# AI Performance Intelligence (FR-AI-012, AIG-005)
# DEV: mock | PROD: http (FastAPI lokal atau OpenAI)
EKASUARI_AI_PROVIDER=mock
EKASUARI_AI_SERVICE_URL=http://127.0.0.1:8001
EKASUARI_AI_TIMEOUT=10
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Early Warning System (FR-EWS-007)
EKASUARI_EWS_GOOD_THRESHOLD=80
EKASUARI_EWS_WARNING_THRESHOLD=60

# PDF Export (FR-RPT-PDF)
EKASUARI_PDF_PAPER=a4
EKASUARI_PDF_ORIENTATION=landscape

# Evidence upload max size (KB)
EKASUARI_MAX_EVIDENCE_SIZE_KB=10240

# Password Policy (FR-IAM-006)
EKASUARI_PASSWORD_MIN_LENGTH=8
EKASUARI_PASSWORD_REQUIRE_UPPERCASE=true
EKASUARI_PASSWORD_REQUIRE_NUMBERS=true
EKASUARI_PASSWORD_REQUIRE_SYMBOLS=false

# Evidence Mandatory on Submit (FR-MSR-007) — set true untuk enforcement
EKASUARI_REQUIRE_EVIDENCE_ON_SUBMIT=false

# Integration Timeout
EKASUARI_INTEGRATIONS_ENABLED=true
EKASUARI_INTEGRATION_TIMEOUT=15

# Cache TTL (detik) — dashboard dan analytics
EKASUARI_CACHE_DASHBOARD_TTL=60
EKASUARI_CACHE_ANALYTICS_TTL=300

# Sanctum stateful domains (PROD: isi domain frontend)
# SANCTUM_STATEFUL_DOMAINS=domain-anda.go.id

VITE_APP_NAME="${APP_NAME}"
